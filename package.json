{
  "name": "terminal",
  "private": true,
  "version": "0.1.0",
  "description": "Lightweight desktop terminal for Windows, Linux and macOS shells, Git and AI agents.",
  "type": "module",
  "workspaces": [
    "ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w ui",
    "build": "npm run build -w ui",
    "typecheck": "npm run typecheck -w ui",
    "test": "npm run test -w ui",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
